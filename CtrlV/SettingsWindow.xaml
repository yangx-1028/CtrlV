<Window x:Class="CtrlV.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YX剪贴板 - 设置"
        Width="400"
        Height="380"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Border Background="White" CornerRadius="8" Margin="0"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.15" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="#F5F7FA" CornerRadius="8,8,0,0"
                    BorderBrush="#EEEEEE" BorderThickness="0,0,0,1">
                <Grid Margin="16,0">
                    <TextBlock Text="设置" FontSize="15" FontWeight="SemiBold"
                               Foreground="#2C3E50" FontFamily="Microsoft YaHei UI"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="×" FontSize="18" Foreground="#999999"
                               FontFamily="Microsoft YaHei UI"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               Cursor="Hand" Padding="4,0"
                               MouseLeftButtonDown="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- 内容区 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20,12,20,0">
                <StackPanel>
                    <!-- 最大记录数 -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="最大历史记录数" FontSize="14" Foreground="#2C3E50"
                                   FontFamily="Microsoft YaHei UI" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="MaxCountBox" Width="80" Height="32" FontSize="14"
                                     FontFamily="Microsoft YaHei UI"
                                     VerticalContentAlignment="Center" Padding="8,4"
                                     BorderBrush="#E8E8E8" BorderThickness="1"/>
                            <TextBlock Text=" 条" VerticalAlignment="Center" FontSize="14"
                                       Foreground="#7F8C8D" FontFamily="Microsoft YaHei UI"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 开机自启 -->
                    <CheckBox x:Name="AutoStartCheckBox"
                              Content="开机自动启动" FontSize="14" Foreground="#2C3E50"
                              FontFamily="Microsoft YaHei UI" Margin="0,0,0,12"/>

                    <!-- 内存占用提醒 -->
                    <StackPanel Margin="0,0,0,12">
                        <CheckBox x:Name="MemoryAlertCheckBox"
                                  Content="内存占用过高时托盘图标闪烁提醒" FontSize="14" Foreground="#2C3E50"
                                  FontFamily="Microsoft YaHei UI" Margin="0,0,0,6"
                                  Checked="MemoryAlertCheckBox_Changed" Unchecked="MemoryAlertCheckBox_Changed"/>
                        <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                            <TextBlock Text="报警阈值：" VerticalAlignment="Center" FontSize="13"
                                       Foreground="#2C3E50" FontFamily="Microsoft YaHei UI"/>
                            <TextBox x:Name="MemoryThresholdBox" Width="56" Height="28" FontSize="13"
                                     FontFamily="Microsoft YaHei UI"
                                     VerticalContentAlignment="Center" Padding="6,2"
                                     BorderBrush="#E8E8E8" BorderThickness="1"
                                     ToolTip="内存占用百分比，达到该值时图标变红闪烁（10~99）"/>
                            <TextBlock Text=" %" VerticalAlignment="Center" FontSize="13"
                                       Foreground="#7F8C8D" FontFamily="Microsoft YaHei UI"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 快捷键设置 -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="快捷键设置" FontSize="14" Foreground="#2C3E50"
                                   FontFamily="Microsoft YaHei UI" Margin="0,0,0,8"/>
                        <Border Background="#F5F7FA" CornerRadius="6" Padding="12,8">
                            <StackPanel>
                                <!-- 修饰键 -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="修饰键：" VerticalAlignment="Center" FontSize="13"
                                               Foreground="#2C3E50" FontFamily="Microsoft YaHei UI" Width="60"/>
                                    <CheckBox x:Name="CtrlCheckBox" Content="Ctrl" FontSize="13"
                                              Foreground="#2C3E50" FontFamily="Microsoft YaHei UI" Margin="0,0,12,0"/>
                                    <CheckBox x:Name="AltCheckBox" Content="Alt" FontSize="13"
                                              Foreground="#2C3E50" FontFamily="Microsoft YaHei UI" Margin="0,0,12,0"/>
                                    <CheckBox x:Name="ShiftCheckBox" Content="Shift" FontSize="13"
                                              Foreground="#2C3E50" FontFamily="Microsoft YaHei UI"/>
                                </StackPanel>
                                <!-- 按键 -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="按键：" VerticalAlignment="Center" FontSize="13"
                                               Foreground="#2C3E50" FontFamily="Microsoft YaHei UI" Width="60"/>
                                    <ComboBox x:Name="KeyComboBox" Width="120" Height="28" FontSize="13"
                                              FontFamily="Microsoft YaHei UI" VerticalContentAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 托盘图标引导 -->
                    <Border Background="#F5F7FA" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
                        <TextBlock Text="💡 固定托盘图标：右键任务栏 → 任务栏设置 → 其他系统托盘图标 → 将 CtrlV 设为「开」"
                                   FontSize="12" Foreground="#7F8C8D" FontFamily="Microsoft YaHei UI"
                                   TextWrapping="Wrap" LineHeight="18"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 底部按钮 -->
            <Border Grid.Row="2" Background="#F5F7FA" CornerRadius="0,0,8,8"
                    BorderBrush="#EEEEEE" BorderThickness="0,1,0,0" Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="保存" Width="80" Height="32" Click="Save_Click"
                            Background="#4A90D9" Foreground="White" BorderThickness="0"
                            FontSize="14" FontFamily="Microsoft YaHei UI" Cursor="Hand" Margin="0,0,8,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="btnBg" Background="{TemplateBinding Background}"
                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="btnBg" Property="Background" Value="#5BA0E9"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="取消" Width="80" Height="32" Click="Cancel_Click"
                            Background="#E0E0E0" Foreground="#2C3E50" BorderThickness="0"
                            FontSize="14" FontFamily="Microsoft YaHei UI" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="btnBg" Background="{TemplateBinding Background}"
                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="btnBg" Property="Background" Value="#D0D0D0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
