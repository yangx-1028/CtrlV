<Window x:Class="CtrlV.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YX剪贴板"
        Width="400"
        Height="600"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Closing="Window_Closing"
        Deactivated="Window_Deactivated"
        Loaded="Window_Loaded">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#4A90D9"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#5BA0E9"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#333333"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#999999"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#EFEFEF"/>

        <!-- 卡片按钮样式 -->
        <Style x:Key="CardActionButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#E0E0E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 添加按钮样式 -->
        <Style x:Key="AddButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 主容器 -->
    <Border Background="#F5F5F5" CornerRadius="0"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.2" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>  <!-- 顶部标题栏 -->
                <RowDefinition Height="Auto"/> <!-- 收藏夹输入区（仅收藏夹模式显示） -->
                <RowDefinition Height="*"/>    <!-- 内容滚动列表 -->
                <RowDefinition Height="Auto"/> <!-- 空状态提示 -->
                <RowDefinition Height="36"/>   <!-- 底部信息栏 -->
            </Grid.RowDefinitions>

            <!-- ========== 顶部标题栏 ========== -->
            <Border Grid.Row="0" Background="White" Padding="16,0"
                    BorderBrush="#EEEEEE" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- 标题 -->
                        <ColumnDefinition Width="*"/>     <!-- Tab按钮 -->
                        <ColumnDefinition Width="Auto"/>  <!-- 关闭按钮 -->
                    </Grid.ColumnDefinitions>

                    <!-- 左侧标题 -->
                    <TextBlock Grid.Column="0" Text="YX剪贴板"
                               FontSize="16" FontWeight="Bold"
                               FontFamily="Microsoft YaHei UI"
                               Foreground="#333333"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"/>

                    <!-- 中间 Tab 按钮 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <!-- 历史记录标签 -->
                        <Border x:Name="TabHistoryBorder"
                                Background="{StaticResource PrimaryBrush}"
                                CornerRadius="12" Padding="14,5"
                                Cursor="Hand" Margin="0,0,8,0"
                                MouseLeftButtonDown="TabHistory_Click">
                            <TextBlock x:Name="TabHistoryText" Text="历史记录"
                                       FontSize="12" FontFamily="Microsoft YaHei UI"
                                       Foreground="White"/>
                        </Border>
                        <!-- 收藏夹标签 -->
                        <Border x:Name="TabFavoriteBorder"
                                Background="#F0F0F0"
                                CornerRadius="12" Padding="14,5"
                                Cursor="Hand"
                                MouseLeftButtonDown="TabFavorite_Click">
                            <TextBlock x:Name="TabFavoriteText" Text="收藏夹"
                                       FontSize="12" FontFamily="Microsoft YaHei UI"
                                       Foreground="#333333"/>
                        </Border>
                    </StackPanel>

                    <!-- 右侧关闭按钮 -->
                    <TextBlock Grid.Column="2" Text="×"
                               FontSize="20" FontWeight="Normal"
                               FontFamily="Microsoft YaHei UI"
                               Foreground="#999999"
                               VerticalAlignment="Center"
                               Cursor="Hand" Padding="4,0"
                               MouseLeftButtonDown="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- ========== 收藏夹输入区（仅在收藏夹模式显示） ========== -->
            <Border x:Name="FavoriteInputArea" Grid.Row="1"
                    Background="White" Padding="12,10,12,10"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#F5F5F5" CornerRadius="8"
                            BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,8,0">
                        <Grid>
                            <TextBlock x:Name="PlaceholderText"
                                       Text="输入常用语，点击添加到收藏夹"
                                       FontSize="13" FontFamily="Microsoft YaHei UI"
                                       Foreground="#BBBBBB"
                                       Padding="12,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                            <TextBox x:Name="FavoriteInputBox"
                                     FontSize="13" FontFamily="Microsoft YaHei UI"
                                     Foreground="#333333"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="12,7"
                                     VerticalContentAlignment="Center"
                                     TextChanged="FavoriteInputBox_TextChanged"/>
                        </Grid>
                    </Border>

                    <Button Grid.Column="1" Content="添加"
                            Style="{StaticResource AddButtonStyle}"
                            Click="AddFavorite_Click"/>
                </Grid>
            </Border>

            <!-- ========== 内容滚动列表 ========== -->
            <ListBox x:Name="ClipListBox"
                     Grid.Row="2"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Padding="12,8">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="CardBorder"
                                Background="White"
                                CornerRadius="8"
                                Padding="16,12"
                                Margin="0,0,0,8"
                                Cursor="Hand"
                                MouseLeftButtonDown="Card_MouseLeftButtonDown"
                                MouseEnter="Card_MouseEnter"
                                MouseLeave="Card_MouseLeave">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/> <!-- 收藏标识 -->
                                    <ColumnDefinition Width="*"/>     <!-- 内容 -->
                                    <ColumnDefinition Width="Auto"/>  <!-- 操作按钮 -->
                                </Grid.ColumnDefinitions>

                                <!-- 收藏标识 ★ -->
                                <TextBlock Grid.Column="0"
                                           Text="★" FontSize="14"
                                           FontFamily="Microsoft YaHei UI"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- 内容文本（单行显示，超长省略） -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Content}"
                                           TextTrimming="CharacterEllipsis"
                                           TextAlignment="Left"
                                           Foreground="#333333"
                                           FontSize="14"
                                           FontFamily="Microsoft YaHei UI"
                                           MaxHeight="20"
                                           ToolTip="{Binding Content}"
                                           ToolTipService.ShowOnDisabled="True"
                                           VerticalAlignment="Center"/>

                                <!-- 操作按钮区域（悬浮显示） -->
                                <StackPanel x:Name="CardActions"
                                            Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Visibility="Collapsed">
                                    <!-- 历史记录模式：显示收藏按钮 -->
                                    <Button x:Name="PinBtn"
                                            Style="{StaticResource CardActionButton}"
                                            Click="PinButton_Click"
                                            Foreground="#999999">
                                        <TextBlock Text="☆收藏" FontSize="12"
                                                   FontFamily="Microsoft YaHei UI"
                                                   Foreground="#999999"/>
                                    </Button>
                                    <!-- 收藏夹模式：显示取消收藏和删除按钮 -->
                                    <Button x:Name="UnpinBtn"
                                            Style="{StaticResource CardActionButton}"
                                            Click="UnpinButton_Click"
                                            Foreground="#999999"
                                            Visibility="Collapsed">
                                        <TextBlock Text="取消收藏" FontSize="12"
                                                   FontFamily="Microsoft YaHei UI"
                                                   Foreground="#999999"/>
                                    </Button>
                                    <Button x:Name="DeleteBtn"
                                            Style="{StaticResource CardActionButton}"
                                            Click="DeleteButton_Click"
                                            Foreground="#999999"
                                            Visibility="Collapsed">
                                        <TextBlock Text="删除" FontSize="12"
                                                   FontFamily="Microsoft YaHei UI"
                                                   Foreground="#E74C3C"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver}" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#EFEFEF"/>
                                <Setter TargetName="CardActions" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsFavoriteView}" Value="True">
                                <Setter TargetName="PinBtn" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="UnpinBtn" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="DeleteBtn" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

            </ListBox>

            <!-- ========== 空状态提示 ========== -->
            <TextBlock x:Name="EmptyHint"
                       Grid.Row="3"
                       Text="暂无剪贴板历史记录&#x0a;复制内容后将自动出现在这里"
                       TextAlignment="Center"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="#999999"
                       FontSize="14"
                       FontFamily="Microsoft YaHei UI"
                       LineHeight="24"
                       Visibility="Collapsed"
                       Margin="0,40,0,40"/>

            <!-- ========== 底部信息栏 ========== -->
            <Border Grid.Row="4" Background="White" Padding="16,0"
                    BorderBrush="#EEEEEE" BorderThickness="0,1,0,0">
                <Grid>
                    <TextBlock x:Name="ItemCountText"
                               Text="共 0 条记录"
                               Foreground="#999999"
                               FontSize="12"
                               FontFamily="Microsoft YaHei UI"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="HotkeyHintText"
                               Text="Ctrl+Alt+V 呼出"
                               Foreground="#999999"
                               FontSize="12"
                               FontFamily="Microsoft YaHei UI"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ========== Toast 提示 ========== -->
            <Border x:Name="ToastBorder"
                    Grid.Row="2"
                    Background="#333333"
                    CornerRadius="6"
                    Padding="16,10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,16"
                    Opacity="0"
                    IsHitTestVisible="False">
                <TextBlock x:Name="ToastText"
                           Foreground="White"
                           FontSize="13"
                           FontFamily="Microsoft YaHei UI"/>
            </Border>
        </Grid>
    </Border>
</Window>